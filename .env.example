# Dayboard configuration. Copy to .env and fill in - it is loaded automatically
# on startup, so you don't have to re-export anything. Everything is optional:
# with none set, Dayboard runs the demo on sample data.

# --- Real AI reasoning (optional) ---
# Free tier key from Google AI Studio. Without it the agent uses fallback rules.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Real Gmail + Calendar, Phase 2 (optional) ---
# OAuth 2.0 Web client from the Google Cloud console (Gmail + Calendar APIs on).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alternative to the two values above: path to the downloaded client_secret.json
# GOOGLE_CLIENT_SECRETS_FILE=/path/to/client_secret.json

# Signs the session cookie that holds the OAuth token. Required for logins to
# persist across restarts in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Pin the OAuth callback to the exact URL registered in Google (needed on Render,
# where the proxy can otherwise produce an http:// mismatch). Local dev can omit.
# OAUTH_REDIRECT_URI=https://your-app.onrender.com/oauth2callback

# --- Personalization (optional) ---
# Your name, shown in the greeting: "Good morning, Pawni".
DAYBOARD_USER_NAME=

# --- Reply voice (optional) ---
# Make AI-drafted replies sound like you. Easiest: copy voice.example.md to
# voice.md and edit it (auto-detected). Or point at a file / set the text inline:
# DAYBOARD_VOICE_FILE=/path/to/voice.md
# DAYBOARD_VOICE="Warm but direct. Greeting: first name. Sign off 'Thanks, Pawni'."
